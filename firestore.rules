rules_version = '2';

// Each signed-in account owns exactly one document tree and can touch nothing
// else. There is no sharing between profiles: each person signs in with their
// own Google account and cannot read anyone else's logs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /cycles/{cycleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
